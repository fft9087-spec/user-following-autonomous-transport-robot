<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="physical_ai_robot">
  <!-- v11: two central powered wheels and four passive yaw/roll casters.
       MDH100 130mm drive, GL65 casters, Nov18 mounts. Rigid-body estimates only; no payload rating validated. -->
  <xacro:arg name="payload_mass" default="0.0"/>
  <xacro:arg name="payload_x" default="0.0"/>
  <xacro:arg name="payload_y" default="0.0"/>
  <xacro:arg name="payload_height" default="0.20"/>
  <xacro:arg name="computer_mass" default="0.0"/>
  <xacro:arg name="wheel_mu" default="0.8"/>
  <xacro:arg name="wheel_mu_lateral" default="0.8"/>
  <xacro:arg name="wheel_torque" default="3.2"/>
  <xacro:arg name="laser_z" default="0.3095"/>
  <xacro:arg name="odometry_source" default="1"/>
  <xacro:arg name="caster_mu" default="0.6"/>
  <xacro:property name="payload_mass" value="$(arg payload_mass)"/>
  <xacro:property name="computer_mass" value="$(arg computer_mass)"/>
  <xacro:property name="payload_height" value="$(arg payload_height)"/>
  <xacro:property name="wheel_radius" value="0.065"/>
  <xacro:property name="wheel_width" value="0.039"/>
  <xacro:property name="track" value="0.4075"/>
  <xacro:include filename="$(find physical_ai_robot_description)/urdf/cad_v11_generated.xacro"/>
  <material name="cargo_brown"><color rgba="0.55 0.32 0.13 1"/></material>
  <link name="base_footprint"/>
  <link name="base_link">
    <visual><geometry><mesh filename="package://physical_ai_robot_description/meshes/cad_v11/base_link.dae"/></geometry></visual>
    <xacro:cad_base_link_inertial/>
    <xacro:cad_base_collisions/>
  </link>
  <joint name="base_footprint_joint" type="fixed"><parent link="base_footprint"/><child link="base_link"/></joint>

  <xacro:macro name="wheel" params="name x y *inertial">
    <link name="${name}_wheel_link">
      <visual><geometry><mesh filename="package://physical_ai_robot_description/meshes/cad_v11/${name}_wheel_link.dae"/></geometry></visual>
      <collision><origin rpy="${pi/2} 0 0"/><geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry></collision>
      <xacro:insert_block name="inertial"/>
    </link>
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/><child link="${name}_wheel_link"/>
      <origin xyz="${x} ${y} 0.06500307"/><axis xyz="0 1 0"/>
      <limit effort="$(arg wheel_torque)" velocity="41.8879"/>
      <!-- Estimated axle losses; distinct from tire/ground Coulomb friction. -->
      <dynamics damping="0.01" friction="0.02"/>
    </joint>
    <gazebo reference="${name}_wheel_link">
      <!-- Collision-local Z is axle/lateral direction and remains so as wheel rotates. -->
      <mu1>$(arg wheel_mu_lateral)</mu1><mu2>$(arg wheel_mu)</mu2><fdir1>0 0 1</fdir1>
      <!-- Use the same small penetration allowance on all six tires. A larger
           drive-wheel deadband lets the four casters carry the whole chassis. -->
      <kp>1000000</kp><kd>100</kd><minDepth>0.0001</minDepth><maxVel>0.1</maxVel>
    </gazebo>
  </xacro:macro>
  <xacro:wheel name="center_left" x="0" y="${track/2}"><xacro:cad_center_left_wheel_link_inertial/></xacro:wheel>
  <xacro:wheel name="center_right" x="0" y="${-track/2}"><xacro:cad_center_right_wheel_link_inertial/></xacro:wheel>

  <!-- GL65 CAD caster: 64mm tire, 22mm trail, 81mm fixed-plate underside.
       A real caster wheel rolls about Y; the fork swivels about Z independently.
       Joint losses/contact stiffness below are initial estimates, not measured values. -->
  <xacro:macro name="caster" params="name x y *swivel_inertial *wheel_inertial">
    <link name="${name}_caster_swivel_link">
      <visual><geometry><mesh filename="package://physical_ai_robot_description/meshes/cad_v11/${name}_caster_swivel_link.dae"/></geometry></visual>
      <collision><origin xyz="0 0 -0.009"/><geometry><cylinder radius="0.018" length="0.018"/></geometry></collision>
      <collision><origin xyz="-0.011 -0.018 -0.030"/><geometry><box size="0.036 0.003 0.035"/></geometry></collision>
      <collision><origin xyz="-0.011 0.018 -0.030"/><geometry><box size="0.036 0.003 0.035"/></geometry></collision>
      <xacro:insert_block name="swivel_inertial"/>
    </link>
    <joint name="${name}_caster_swivel_joint" type="continuous">
      <parent link="base_link"/><child link="${name}_caster_swivel_link"/>
      <origin xyz="${x} ${y} 0.081"/><axis xyz="0 0 1"/>
      <limit effort="0" velocity="30"/><dynamics damping="0.01" friction="0.002"/>
    </joint>
    <link name="${name}_caster_wheel_link">
      <visual><geometry><mesh filename="package://physical_ai_robot_description/meshes/cad_v11/${name}_caster_wheel_link.dae"/></geometry></visual>
      <collision><origin rpy="${pi/2} 0 0"/><geometry><cylinder radius="0.032" length="0.023"/></geometry></collision>
      <xacro:insert_block name="wheel_inertial"/>
    </link>
    <joint name="${name}_caster_wheel_joint" type="continuous">
      <parent link="${name}_caster_swivel_link"/><child link="${name}_caster_wheel_link"/>
      <origin xyz="-0.022 0 -0.049"/><axis xyz="0 1 0"/>
      <limit effort="0" velocity="60"/><dynamics damping="0.0005" friction="0.001"/>
    </joint>
    <gazebo reference="${name}_caster_wheel_link">
      <mu1>$(arg caster_mu)</mu1><mu2>$(arg caster_mu)</mu2><fdir1>0 0 1</fdir1>
      <kp>200000</kp><kd>50</kd><minDepth>0.0001</minDepth><maxVel>0.1</maxVel>
    </gazebo>
  </xacro:macro>
  <xacro:caster name="front_left" x="0.165" y="0.185"><xacro:cad_front_left_caster_swivel_link_inertial/><xacro:cad_front_left_caster_wheel_link_inertial/></xacro:caster>
  <xacro:caster name="front_right" x="0.165" y="-0.185"><xacro:cad_front_right_caster_swivel_link_inertial/><xacro:cad_front_right_caster_wheel_link_inertial/></xacro:caster>
  <xacro:caster name="rear_left" x="-0.165" y="0.185"><xacro:cad_rear_left_caster_swivel_link_inertial/><xacro:cad_rear_left_caster_wheel_link_inertial/></xacro:caster>
  <xacro:caster name="rear_right" x="-0.165" y="-0.185"><xacro:cad_rear_right_caster_swivel_link_inertial/><xacro:cad_rear_right_caster_wheel_link_inertial/></xacro:caster>

  <!-- Optical scan plane is assumed within the CAD scanner envelope; measure before hardware use. -->
  <link name="laser_frame">
    <visual><origin xyz="0 0 ${0.3095-float('$(arg laser_z)')}"/><geometry><mesh filename="package://physical_ai_robot_description/meshes/cad_v11/laser_frame.dae"/></geometry></visual>
  </link>
  <joint name="laser_joint" type="fixed"><parent link="base_link"/><child link="laser_frame"/><origin xyz="0.2674 0 $(arg laser_z)"/></joint>
  <gazebo reference="laser_frame">
    <sensor name="laser" type="ray">
      <always_on>true</always_on><update_rate>10</update_rate><visualize>false</visualize>
      <ray><scan><horizontal><samples>720</samples><resolution>1</resolution><min_angle>-${pi}</min_angle><max_angle>${pi}</max_angle></horizontal></scan>
        <range><min>0.20</min><max>12.0</max><resolution>0.01</resolution></range>
        <noise><type>gaussian</type><mean>0</mean><stddev>0.005</stddev></noise>
      </ray>
      <plugin name="laser_controller" filename="libgazebo_ros_ray_sensor.so"><ros><remapping>~/out:=scan</remapping></ros><output_type>sensor_msgs/LaserScan</output_type><frame_name>laser_frame</frame_name></plugin>
    </sensor>
  </gazebo>
  <!-- CAD camera position only: an image sensor plugin is not enabled by this revision. -->
  <link name="camera_link"/>
  <joint name="camera_joint" type="fixed"><parent link="base_link"/><child link="camera_link"/><origin xyz="0.3551 0 0.2895"/></joint>
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed"><parent link="camera_link"/><child link="camera_optical_frame"/><origin rpy="${-pi/2} 0 ${-pi/2}"/></joint>
  <!-- Future mounting frame only: do not add a non-CAD pedestal to the visual. -->
  <link name="arm_mount_link"/>
  <joint name="arm_mount_joint" type="fixed"><parent link="base_link"/><child link="arm_mount_link"/><origin xyz="-0.05 0 0.277"/></joint>

  <xacro:if value="${payload_mass > 0}">
    <link name="payload_link">
      <visual><geometry><box size="0.24 0.24 ${payload_height}"/></geometry><material name="cargo_brown"/></visual>
      <collision><geometry><box size="0.24 0.24 ${payload_height}"/></geometry></collision>
      <inertial><mass value="${payload_mass}"/><inertia ixx="${payload_mass*(0.24**2+payload_height**2)/12}" ixy="0" ixz="0" iyy="${payload_mass*(0.24**2+payload_height**2)/12}" iyz="0" izz="${payload_mass*2*0.24**2/12}"/></inertial>
    </link>
    <joint name="payload_joint" type="fixed"><parent link="base_link"/><child link="payload_link"/><origin xyz="$(arg payload_x) $(arg payload_y) ${0.277+payload_height/2}"/></joint>
    <gazebo reference="payload_link"><material>Gazebo/Wood</material></gazebo>
  </xacro:if>
  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros><remapping>cmd_vel:=cmd_vel_safe</remapping><remapping>odom:=odom</remapping></ros>
      <update_rate>50</update_rate><num_wheel_pairs>1</num_wheel_pairs>
      <left_joint>center_left_wheel_joint</left_joint>
      <right_joint>center_right_wheel_joint</right_joint>
      <wheel_separation>${track}</wheel_separation>
      <wheel_diameter>${2*wheel_radius}</wheel_diameter>
      <!-- Conservative constant cap at manufacturer rated torque; not an electrical motor model. -->
      <!-- Velocity/acceleration ramps are applied once in sim_motion_guard.
           Disable this plugin's separate per-wheel integrator to avoid wind-up under skid load. -->
      <max_wheel_torque>$(arg wheel_torque)</max_wheel_torque><max_wheel_acceleration>0</max_wheel_acceleration>
      <odometry_source>$(arg odometry_source)</odometry_source>
      <publish_odom>true</publish_odom><publish_odom_tf>true</publish_odom_tf><publish_wheel_tf>false</publish_wheel_tf>
      <odometry_frame>odom</odometry_frame><robot_base_frame>base_footprint</robot_base_frame>
    </plugin>
    <plugin name="joint_states" filename="libgazebo_ros_joint_state_publisher.so">
      <update_rate>50</update_rate>
      <joint_name>center_left_wheel_joint</joint_name><joint_name>center_right_wheel_joint</joint_name>
      <joint_name>front_left_caster_swivel_joint</joint_name><joint_name>front_left_caster_wheel_joint</joint_name>
      <joint_name>front_right_caster_swivel_joint</joint_name><joint_name>front_right_caster_wheel_joint</joint_name>
      <joint_name>rear_left_caster_swivel_joint</joint_name><joint_name>rear_left_caster_wheel_joint</joint_name>
      <joint_name>rear_right_caster_swivel_joint</joint_name><joint_name>rear_right_caster_wheel_joint</joint_name>
    </plugin>
  </gazebo>
</robot>

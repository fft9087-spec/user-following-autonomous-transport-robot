<?xml version="1.0"?>
<sdf version="1.6"><world name="cad_physics_test">
  <gravity>0 0 -9.81</gravity>
  <include><uri>model://sun</uri></include>
  <physics name="ode" type="ode"><max_step_size>0.001</max_step_size><real_time_update_rate>1000</real_time_update_rate><ode><solver><type>quick</type><iters>100</iters><sor>1.3</sor></solver></ode></physics>
  <model name="ground_plane"><static>true</static><link name="link">
    <collision name="ground"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
    <visual name="ground"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry><material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
  </link></model>
  <model name="scan_target"><static>true</static><pose>2 0 0.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.10 4 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.10 4 1</size></box></geometry></visual></link></model>
  <gui><camera name="user_camera"><pose>1.5 -2 1.3 0 0.4 2.2</pose></camera></gui>
</world></sdf>
